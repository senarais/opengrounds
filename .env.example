# --- Chain (Sepolia) ---
SEPOLIA_RPC_URL=
DEPLOYER_ADDRESS=              # alamat publik deployer; private key disimpan di keystore (cast wallet import), BUKAN di sini
ETHERSCAN_API_KEY=

# --- Attestation 2-dari-3: slot PLATFORM (backend), COUNTERPARTY (owner per seri, wallet Privy), VERIFIER (independen) ---
ATTESTOR_VERIFIER_ADDRESS=     # wallet verifier (MetaMask), pihak independen. Pengganti SIGNER_3_ADDRESS
ATTESTOR_PLATFORM_ADDRESS=     # opsional; default = OPERATOR_ADDRESS. Kunci privatnya: ATTESTOR_PLATFORM_PRIVATE_KEY (default = OPERATOR_PRIVATE_KEY)
TREASURY_ADDRESS=              # opsional; pemegang token yang belum terjual. Default = OPERATOR_ADDRESS
# REGISTRY_ADDRESS=            # opsional; menimpa packages/contracts/deployments/latest.json

# --- PSP (PaymentProvider). xendit = pembelian investor lewat Xendit mode uji; mock = sandbox berlabel. Split venue selalu mock (xenPlatform belum aktif) ---
PSP_MODE=mock                  # mock | xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- AI via gateway Morphic (OpenAI-compatible; hanya terima teks yang sudah diredaksi) ---
LLM_BASE_URL=https://morphic-api.web.id/v1
LLM_API_KEY=                   # isi sendiri di .env, jangan commit
LLM_MODEL=                     # nama model yang tersedia di akun Morphic Anda

# --- Supabase (skema `pos` dan `platform`) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=             # boleh ke browser; hanya baca data publik (lihat RLS di 0003)
SUPABASE_SERVICE_ROLE_KEY=     # SERVER ONLY. Jangan pernah ke browser / NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Apps ---
POS_URL=http://localhost:3001
PLATFORM_URL=http://localhost:3000

# --- Operator platform (diisi otomatis oleh scripts/setup-operator.sh; hot wallet TESTNET, server only) ---
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=

# KYC nyata (Didit). Kosong = pakai KYC mock yang dilabeli.
# Didit Console → Settings → API & Webhooks (API key, webhook secret) dan Workflows (workflow id).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
XENDIT_SPLIT=off

# Wallet investor otomatis (Privy, custom auth dari login Supabase). Wajib untuk investor dan owner.
# Dashboard Privy: Authentication → JWT-based auth → JWKS endpoint https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json, claim user id = sub.
# Supabase: Settings → JWT Keys → pakai signing key ASIMETRIS (bukan secret lama). Allowed origins Privy: http://localhost:3000
NEXT_PUBLIC_PRIVY_APP_ID=

# Token rahasia antar-app: PoS memberi tahu platform tiap pembayaran settle (split s% ke kantong SPV), juga kunci HMAC webhook sandbox.
# Isi string acak panjang (mis. `openssl rand -hex 32`).
INTERNAL_API_TOKEN=
